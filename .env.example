# DeepSeek Anthropic-compatible API configuration
ANTHROPIC_AUTH_TOKEN=replace-with-your-api-key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash

# 协议选择：anthropic（POST /v1/messages）或 responses（POST /responses）。
# 必须与 base URL 实际提供的接口一致，否则会得到 404/502。
# 注意：部分网关按 User-Agent 过滤，本项目已为两条协议路径统一设置 UA。
#
# 如何选择：若需要**可验证的思考深度**，必须用 responses ——
# 只有它会回报 reasoning_tokens；anthropic 的 thinking 参数虽被接受，
# 但响应里没有用量，无法确认是否真的生效。
LLM_API_PROTOCOL=anthropic

# 思考深度 / reasoning effort：minimal | low | medium | high
# 留空 = 不显式指定（gpt-5.5 保留历史默认 low）。
# 两条协议的原生写法不同，代码会自动映射：
#   responses → reasoning.effort
#   anthropic → thinking.budget_tokens（minimal 1024 / low 2048 / medium 4096 / high 8192）
# ⚠️ 修改该值会改变缓存键，不会命中旧深度的缓存结果。
LLM_REASONING_EFFORT=

# 瞬时故障重试次数（含首次尝试，上限 8）。网关抖动频繁时可调大：
# 单次调用最坏耗时 ≈ 尝试次数 × 响应超时 + 退避合计（按 1/2/4/8… 秒）。
LLM_MAX_ATTEMPTS=4
# 单次 HTTP 请求超时（秒）
LLM_HTTP_TIMEOUT_SECONDS=60
# 单次调用的总墙钟预算（秒）：预算耗尽即停止重试并抛出。
# 没有它时 尝试次数 × 请求超时 会变成小时级耗时（实测踩过）。
LLM_CALL_BUDGET_SECONDS=90

# Authentication configuration. Use strong, unique values in the real .env file.
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional Agent Skills directory. Defaults to <repository>/skills when unset.
# SKILLS_DIR=X:\path\to\skills

# ── 异步分析任务（第 5 项）──
# 同时运行的分析任务上限：超出的排队，而不是一起冲进线程池
# ANALYZE_MAX_CONCURRENT=4
# 单个分析任务的超时（秒）；到点取消并标记 TIMEOUT
# ANALYZE_TIMEOUT_SECONDS=900
# 日志级别（结构化 JSON 输出到 stdout）
# LOG_LEVEL=INFO
