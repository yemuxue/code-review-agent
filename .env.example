# DeepSeek Anthropic-compatible API configuration
ANTHROPIC_AUTH_TOKEN=replace-with-your-api-key
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-flash

# Authentication configuration. Use strong, unique values in the real .env file.
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional Agent Skills directory. Defaults to <repository>/skills when unset.
# SKILLS_DIR=X:\path\to\skills
