@startuml
!include _style.iuml
left to right direction
title <size:26><b>F01  系统上下文图</b></size>\n<size:14><color:#5A6678>谁使用它、它读写哪些外部系统；角色用颜色区分</color></size>

actor "代码作者" as A1
actor "Reviewer" as A2
actor "平台管理员" as A3

rectangle "可信代码审查 Agent（本次范围）" as SYS #F8FAFF {
  component "接入变更集\nPR / commit range · diff" as C1
  component "分析\n静态规则 + 模型逐块审查" as C2
  component "发现与证据\n文件 · 行号 · 代码片段" as C3
  component "修复补丁\n只读预览 · 写前备份" as C4
  component "验证\npytest / ruff / 回归" as C5
  component "结论与放行\n默认不阻断 · 命中规则才需人工" as C6
}

component "«外部系统»\nGitHub / GitLab" as X1
component "«外部系统»\n模型服务（LLM）" as X2
component "«外部系统»\nCI 测试环境" as X3
component "«外部系统»\n审计与存储" as X4

A1 -[#2E6BFF]-> C1 : 提交变更
A1 -[#2E6BFF]-> C4 : 生成补丁
A2 -[#0F766E]-> C3 : 复核发现
A2 -[#0F766E]-> C6 : 放行 / 阻断
A3 -[#B45309]-> C6 : 维护规则

C1 <--> X1 : 读写 PR 与 diff
C2 --> X2 : 逐块审查
C4 --> X1 : 写回检查项
C5 --> X3 : 执行验证
C6 --> X4 : 写入放行记录

caption \n<size:13><color:#5A6678>注：弯箭头颜色区分角色——蓝=代码作者、绿=Reviewer、琥珀=平台管理员；管理员不读业务内容，只看元数据与放行依据。</color></size>
@enduml
